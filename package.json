{
  "name": "live-energy-card",
  "version": "0.17.0",
  "description": "Modern animated energy flow card for Home Assistant",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Pyozer/ha-live-energy-card#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyozer/ha-live-energy-card.git"
  },
  "bugs": {
    "url": "https://github.com/Pyozer/ha-live-energy-card/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "watch": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "lint": "oxlint --deny-warnings src demo test scripts",
    "format": "prettier --write src demo test scripts",
    "format:check": "prettier --check src demo test scripts",
    "check": "npm run lint && npm run format:check && npm run coverage && npm run build && npm run size",
    "preversion": "npm run check",
    "release": "npm version -m 'chore: release %s'"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26"
  }
}
