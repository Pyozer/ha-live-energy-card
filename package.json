{
  "name": "live-energy-card",
  "version": "0.14.0",
  "description": "Modern animated energy flow card for Home Assistant",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "watch": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "lint": "eslint src demo test scripts",
    "format": "prettier --write src demo test scripts",
    "format:check": "prettier --check src demo test scripts",
    "check": "npm run lint && npm run format:check && npm run coverage && npm run build && npm run size"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
